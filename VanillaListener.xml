<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<!--
		VLWindowTemplate
		Shared chrome for all VanillaListener windows.
	-->
	<Frame name="VLWindowTemplate" virtual="true"
		movable="true" resizable="true" enableMouse="true" frameStrata="MEDIUM">

		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
			edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
			tile="true" tileSize="32" edgeSize="32">
			<BackgroundInsets>
				<AbsInset left="11" right="12" top="12" bottom="11"/>
			</BackgroundInsets>
		</Backdrop>

		<FontString name="$parentTitle" inherits="GameFontNormal" justifyH="CENTER">
			<Anchors>
				<Anchor point="TOP" relativePoint="TOP">
					<Offset><AbsDimension x="0" y="-15"/></Offset>
				</Anchor>
			</Anchors>
		</FontString>

		<Button name="$parentClose" inherits="UIPanelCloseButton">
			<Anchors>
				<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
					<Offset><AbsDimension x="-5" y="-5"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>this:GetParent():Hide()</OnClick>
			</Scripts>
		</Button>

		<Button name="$parentResizeGrip">
			<Size><AbsDimension x="16" y="16"/></Size>
			<Anchors>
				<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
					<Offset><AbsDimension x="-7" y="7"/></Offset>
				</Anchor>
			</Anchors>
			<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
			<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
			<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
			<Scripts>
				<OnMouseDown>this:GetParent():StartSizing("BOTTOMRIGHT")</OnMouseDown>
				<OnMouseUp>
					this:GetParent():StopMovingOrSizing()
					VanillaListener:SaveWindowPosition(this:GetParent())
				</OnMouseUp>
			</Scripts>
		</Button>

		<Scripts>
			<OnLoad>
				this:RegisterForDrag("LeftButton")
			</OnLoad>
			<OnDragStart>this:StartMoving()</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing()
				VanillaListener:SaveWindowPosition(this)
			</OnDragStop>
		</Scripts>

	</Frame>


	<!-- ============================================================
		MAIN WINDOW
	============================================================ -->
	<Frame name="VLMainFrame" inherits="VLWindowTemplate" hidden="true">
		<Size><AbsDimension x="250" y="400"/></Size>
		<Anchors>
			<Anchor point="CENTER" relativePoint="CENTER">
				<Offset><AbsDimension x="-150" y="0"/></Offset>
			</Anchor>
		</Anchors>


		<EditBox name="VLMainInput" inherits="InputBoxTemplate" autoFocus="false">
			<Size><AbsDimension x="130" y="20"/></Size>
			<Anchors>
				<Anchor point="TOPLEFT" relativePoint="TOPLEFT">
					<Offset><AbsDimension x="20" y="-50"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnEnterPressed>VanillaListener:AddPlayerFromInput()</OnEnterPressed>
			</Scripts>
		</EditBox>

		<Button name="VLMainAddButton" inherits="UIPanelButtonTemplate">
			<Size><AbsDimension x="55" y="20"/></Size>
			<Anchors>
				<Anchor point="LEFT" relativeTo="VLMainInput" relativePoint="RIGHT">
					<Offset><AbsDimension x="6" y="0"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnLoad>this:SetText("Add")</OnLoad>
				<OnClick>VanillaListener:AddPlayerFromInput()</OnClick>
			</Scripts>
		</Button>

		<ScrollFrame name="VLMainListScroll" inherits="UIPanelScrollFrameTemplate">
			<Anchors>
				<Anchor point="TOPLEFT" relativePoint="TOPLEFT">
					<Offset><AbsDimension x="15" y="-80"/></Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
					<Offset><AbsDimension x="-30" y="45"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnLoad>
					VLMainListScroll:SetScrollChild(VLMainListContent)
				</OnLoad>
			</Scripts>
		</ScrollFrame>

		<Frame name="VLMainListContent" parent="VLMainFrame">
			<Size><AbsDimension x="185" y="1"/></Size>
		</Frame>

		<!-- Bottom bar -->
		<Button name="VLMainDecFont" inherits="UIPanelButtonTemplate">
			<Size><AbsDimension x="22" y="20"/></Size>
			<Anchors>
				<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
					<Offset><AbsDimension x="14" y="12"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnLoad>this:SetText("-")</OnLoad>
				<OnClick>VanillaListener:ChangeFontSize(-1)</OnClick>
			</Scripts>
		</Button>

		<Button name="VLMainIncFont" inherits="UIPanelButtonTemplate">
			<Size><AbsDimension x="22" y="20"/></Size>
			<Anchors>
				<Anchor point="LEFT" relativeTo="VLMainDecFont" relativePoint="RIGHT">
					<Offset><AbsDimension x="2" y="0"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnLoad>this:SetText("+")</OnLoad>
				<OnClick>VanillaListener:ChangeFontSize(1)</OnClick>
			</Scripts>
		</Button>

		<CheckButton name="VLMainLiveCheck" inherits="UICheckButtonTemplate">
			<Size><AbsDimension x="20" y="20"/></Size>
			<Anchors>
				<Anchor point="LEFT" relativeTo="VLMainIncFont" relativePoint="RIGHT">
					<Offset><AbsDimension x="8" y="0"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					VanillaListener.db.char.autoUpdate = (this:GetChecked() == 1)
				</OnClick>
			</Scripts>
		</CheckButton>

		<CheckButton name="VLMainNotifyCheck" inherits="UICheckButtonTemplate">
			<Size><AbsDimension x="20" y="20"/></Size>
			<Anchors>
				<Anchor point="LEFT" relativeTo="VLMainLiveCheck" relativePoint="RIGHT">
					<Offset><AbsDimension x="22" y="0"/></Offset>
				</Anchor>
			</Anchors>
			<Scripts>
				<OnClick>
					VanillaListener.db.char.notify = (this:GetChecked() == 1)
				</OnClick>
			</Scripts>
		</CheckButton>

		<Scripts>
			<OnShow>VanillaListener:RestoreWindowPosition(this)</OnShow>
		</Scripts>
	</Frame>


	<!-- ============================================================
		HISTORY WINDOW
	============================================================ -->
	<Frame name="VLHistoryFrame" inherits="VLWindowTemplate" hidden="true">
		<Size><AbsDimension x="400" y="300"/></Size>
		<Anchors>
			<Anchor point="CENTER" relativePoint="CENTER">
				<Offset><AbsDimension x="150" y="0"/></Offset>
			</Anchor>
		</Anchors>


		<ScrollingMessageFrame name="VLHistoryChatBox" fade="false" maxLines="200">
			<Anchors>
				<Anchor point="TOPLEFT" relativePoint="TOPLEFT">
					<Offset><AbsDimension x="18" y="-38"/></Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
					<Offset><AbsDimension x="-18" y="22"/></Offset>
				</Anchor>
			</Anchors>
			<FontString font="Fonts\FRIZQT__.TTF" justifyH="LEFT">
				<FontHeight><AbsValue val="12"/></FontHeight>
			</FontString>
		</ScrollingMessageFrame>

		<Scripts>
			<OnShow>VanillaListener:RestoreWindowPosition(this)</OnShow>
			<OnSizeChanged>VanillaListener:SaveWindowPosition(this)</OnSizeChanged>
		</Scripts>
	</Frame>


	<!-- ============================================================
		SNOOPER WINDOW
	============================================================ -->
	<Frame name="VLSnooperFrame" inherits="VLWindowTemplate" hidden="true">
		<Size><AbsDimension x="320" y="180"/></Size>
		<Anchors>
			<Anchor point="CENTER" relativePoint="CENTER">
				<Offset><AbsDimension x="0" y="-200"/></Offset>
			</Anchor>
		</Anchors>


		<ScrollingMessageFrame name="VLSnooperChatBox" fade="false" maxLines="50">
			<Anchors>
				<Anchor point="TOPLEFT" relativePoint="TOPLEFT">
					<Offset><AbsDimension x="18" y="-38"/></Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
					<Offset><AbsDimension x="-18" y="22"/></Offset>
				</Anchor>
			</Anchors>
			<FontString font="Fonts\FRIZQT__.TTF" justifyH="LEFT">
				<FontHeight><AbsValue val="12"/></FontHeight>
			</FontString>
		</ScrollingMessageFrame>

		<Scripts>
			<OnShow>VanillaListener:RestoreWindowPosition(this)</OnShow>
			<OnSizeChanged>VanillaListener:SaveWindowPosition(this)</OnSizeChanged>
		</Scripts>
	</Frame>

</Ui>
